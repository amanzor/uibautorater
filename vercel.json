{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/rater",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rater.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "https://maxai.vercel.app/privacy",
      "permanent": false
    },
    {
      "source": "/max.js",
      "destination": "https://maxai.vercel.app/max.js",
      "permanent": false
    }
  ]
}
